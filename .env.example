# ---- App ----
APP_ENV=development
API_KEY=change-me-dev-key
RATE_LIMIT_PER_MINUTE=60
AUTO_BOOTSTRAP=true

# ---- Data stores (local dev; docker-compose overrides the hosts) ----
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/shoppilot
REDIS_URL=redis://localhost:6379/0

# ---- LLM: rules (no key, offline) | openai | ollama ----
LLM_PROVIDER=rules
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Embeddings: hash (no download) | sentence-transformers ----
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Business rules ----
RETURN_WINDOW_DAYS=30
